<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Kindlify icon. Both read the clipboard once the app is on screen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="paste_into_latest"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_paste"
        android:shortcutShortLabel="@string/shortcut_paste_latest_short"
        android:shortcutLongLabel="@string/shortcut_paste_latest_long">
        <intent
            android:action="io.github.ddastoor.kindlify.action.PASTE_INTO_LATEST"
            android:targetPackage="io.github.ddastoor.kindlify"
            android:targetClass="io.github.ddastoor.kindlify.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="paste_into_new"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new"
        android:shortcutShortLabel="@string/shortcut_paste_new_short"
        android:shortcutLongLabel="@string/shortcut_paste_new_long">
        <intent
            android:action="io.github.ddastoor.kindlify.action.PASTE_INTO_NEW"
            android:targetPackage="io.github.ddastoor.kindlify"
            android:targetClass="io.github.ddastoor.kindlify.MainActivity" />
    </shortcut>
</shortcuts>
